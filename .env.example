# Creator Engagement Project deployment parameters.
LLM_API_KEY=""
LLM_API_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_TIMEOUT=30

MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="creator_engagement"
JOB_STORE_BACKEND="mongodb"

PROXY_51_API_URL=""
PROXY_MODE="required"
PROXY_POOL_SIZE=8
PROXY_MAX_CONCURRENCY=1

# Production safety boundary. Account Cookies, official-account credentials,
# WeChat sidecars and historical profiles are ignored except for the explicit
# XIAOHONGSHU_SESSION_MODE=cookie and DOUYIN_AUTHOR_SESSION_MODE=cookie opt-ins below.
STRICT_ANONYMOUS_MODE=true

# Explicit opt-in for XHS root comments. The cookie stays local and is only
# sent to edith.xiaohongshu.com. Required names: a1 and web_session.
XIAOHONGSHU_SESSION_MODE="disabled"
XIAOHONGSHU_COOKIE=""

# Author collection uses fresh guest sessions only. This switch overrides ALL
# author Cookie settings and saved browser/localStorage sessions below.
AUTHOR_GUEST_ONLY=true
# Legacy opt-in account mode is ignored while AUTHOR_GUEST_ONLY=true.
DOUYIN_AUTHOR_SESSION_MODE="anonymous"
DOUYIN_AUTHOR_COOKIE=""

# Legacy author credentials; ignored while AUTHOR_GUEST_ONLY=true.
AUTHOR_USE_SAVED_SESSIONS=false
KUAISHOU_AUTHOR_COOKIE=""
WEIBO_AUTHOR_COOKIE=""
BILIBILI_AUTHOR_COOKIE=""
TOUTIAO_AUTHOR_COOKIE=""

# Legacy compatibility only; ignored while STRICT_ANONYMOUS_MODE=true.
CREATOR_ENGAGEMENT_COOKIE=""
# Compatibility alias used by existing deployments.
DOUYIN_SESSION_COOKIE=""

# Legacy compatibility only; ignored while STRICT_ANONYMOUS_MODE=true.
WECHAT_ARTICLE_COOKIE=""

# Optional official API credentials for articles owned by this Official Account.
# Keep real secrets only in .local/env/.env; never commit them.
WECHAT_MP_APP_ID=""
WECHAT_MP_APP_SECRET=""
# Optional authorizer/access token alternative. It takes precedence over AppSecret.
WECHAT_MP_ACCESS_TOKEN=""

# Legacy optional local WeChat desktop session bridge. Leave both values empty
# for the Cookie-only deployment documented in docs/WECHAT_COOKIE_PROTOCOL.md.
WECHAT_SESSION_BRIDGE_URL=""
WECHAT_SESSION_BRIDGE_TOKEN=""

# Optional authorized desktop WeChat Channels sidecar. Required for comment
# bodies and mobile commonFinderJsApi/feedID interaction data. It is ignored
# while STRICT_ANONYMOUS_MODE=true. See docs/WECHAT_CHANNELS_BRIDGE.md.
WECHAT_CHANNELS_BRIDGE_URL=""
WECHAT_CHANNELS_BRIDGE_TOKEN=""

REQUEST_TIMEOUT_SECONDS=20
# Whole synchronous API budget (queueing, retries and comment pagination).
API_SYNC_TIMEOUT_SECONDS=120
# 0 disables the item-count limit; concurrency and timeouts still apply.
API_SYNC_MAX_ITEMS=0
REQUEST_CONNECT_TIMEOUT_SECONDS=5
COLLECTION_MAX_CONCURRENCY=8
DOUYIN_MAX_CONCURRENCY=4
JOB_MAX_CONCURRENCY=2
JOB_RESULT_TTL_SECONDS=86400
# SQLite is retained as an explicit rollback backend.
JOB_DB_PATH=".local/jobs/jobs.sqlite3"
JOB_MAX_ITEMS=0
JOB_RESULT_MAX_BYTES=8388608
JOB_WEBHOOK_ALLOWED_HOSTS=""
JOB_WEBHOOK_TIMEOUT_SECONDS=10
JOB_WEBHOOK_MAX_ATTEMPTS=3
RELIABILITY_MODE="enterprise"
PROTOCOL_MAX_ATTEMPTS=3
PROTOCOL_RETRY_BASE_SECONDS=1
TOUTIAO_PROTOCOL_MAX_ATTEMPTS=1
DOUYIN_PROTOCOL_MAX_ATTEMPTS=8
ENGAGEMENT_FAILURE_CACHE_TTL_SECONDS=15
CIRCUIT_FAILURE_THRESHOLD=24
CIRCUIT_COOLDOWN_SECONDS=20
ENGAGEMENT_CACHE_TTL_SECONDS=120
ENGAGEMENT_CACHE_MAX_ENTRIES=1000
ENGAGEMENT_CACHE_MAX_BYTES=67108864
BROWSER_FALLBACK_ENABLED=true
BROWSER_TIMEOUT_SECONDS=35
BROWSER_CHALLENGE_WAIT_SECONDS=5
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENCY=3
BROWSER_MAX_ATTEMPTS=3

# 异步任务硬边界：限制活跃单条数、单条耗时和整批耗时。
JOB_ITEM_MAX_CONCURRENCY=16
JOB_ITEM_TIMEOUT_SECONDS=90
# 每 500 条给予 1800 秒，向上取整，整批最多 24 小时；设为 0 关闭整批时限。
JOB_TIMEOUT_SECONDS=1800
JOB_TIMEOUT_BATCH_SIZE=500
BROWSER_GEOIP_ENABLED=false
BROWSER_RESET_GUEST_STATE_ON_PROXY_CHANGE=true
BROWSER_PROFILE_DIR=".local/browser-profiles"
PLATFORM_SESSION_DIR=".local/platform-sessions"
LOG_LEVEL="INFO"

API_HOST="0.0.0.0"
API_PORT=8200
