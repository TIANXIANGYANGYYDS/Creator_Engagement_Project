+++ b/internal/api/search_feed_profile_test.go
@@ -99,1 +99,24 @@ func TestGetFeedProfileKeepsNormalRPCForFeedURLs(t *testing.T) {
+func TestGetFeedProfilePassesEncryptedObjectID(t *testing.T) {
+	t.Parallel()
+
+	var calledBody websocket.FeedProfileBody
+	service := &SearchService{
+		callAPI: func(_ string, body interface{}, _ time.Duration) ([]byte, error) {
+			calledBody = body.(websocket.FeedProfileBody)
+			return []byte(`{"errCode":0,"data":{"object":{"id":"feed-1"}}}`), nil
+		},
+	}
+
+	req := httptest.NewRequest(http.MethodGet, "/api/channels/feed/profile?encrypted_object_id=export%2Fabc_123", nil)
+	rec := httptest.NewRecorder()
+	service.GetFeedProfile(rec, req)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200", rec.Code)
+	}
+	if calledBody.EncryptedObjectID != "export/abc_123" {
+		t.Fatalf("encrypted object ID = %q", calledBody.EncryptedObjectID)
+	}
+}
